---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/shop/Catalog.jsx';
import { getCatalog } from '../lib/catalog.js';
const { products, error } = await getCatalog();
---

<Layout title="La col·lecció">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="Ruta de navegació">
      <a href="/">Inici</a>
      <span aria-hidden="true">/</span>
      <span>La col·lecció</span>
    </nav>
    <section class="catalog-intro">
      <p class="eyebrow">TRIA UNA PEÇA AMB HISTÒRIA</p>
      <h1>
        Ganxet per als
        <br />
        <span>teus petits moments.</span>
      </h1>
      <p>
        Bosses, xals i peces que porten color al dia a dia.
        <br />
        Tot fet a mà per la nostra iaia Clara, punt a punt.
      </p>
      <span class="catalog-flower" aria-hidden="true">
        <img src="/images/figma/imgVector3.svg" alt="" width="206" height="205.99" />
      </span>
    </section>
    <Catalog
      client:load
      products={products}
      error={error}
      initialCategory={Astro.url.searchParams.get('categoria') || ''}
      initialQuery={Astro.url.searchParams.get('q') || ''}
      initialSort={Astro.url.searchParams.get('ordre') || 'featured'}
    />
  </div>
  <section class="small-contact page-width">
    <h2>No trobes la peça que buscaves?</h2>
    <p>Ens pots escriure. T’expliquem què està teixint la Clara.</p>
    <a class="text-link" href="/contacte">
      Parlem-ne ↗
    </a>
  </section>
</Layout>
