---
import Layout from '../../layouts/Layout.astro';
import ProductView from '../../components/shop/ProductView.jsx';
import ProductCard from '../../components/shop/ProductCard.jsx';
import { getCatalog } from '../../lib/catalog.js';
import { store } from '../../lib/store.js';
const catalog = await getCatalog();
const product = catalog.products.find((p) => p.id === Astro.params.id);
if (!product) Astro.response.status = 404;
const related = catalog.products.filter((p) => p.id !== product?.id).slice(0, 3);
const structuredData =
  product && !product.preview
    ? {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: product.name,
        description: product.description,
        image: product.images.map((i) => i.url),
        brand: { '@type': 'Brand', name: store.name },
        ...(product.price !== null
          ? {
              offers: {
                '@type': 'Offer',
                priceCurrency: 'EUR',
                price: product.price,
                ...(product.stock !== null
                  ? {
                      availability: `https://schema.org/${product.available ? 'InStock' : 'OutOfStock'}`,
                    }
                  : {}),
                url: Astro.url.href,
              },
            }
          : {}),
      }
    : null;
---

<Layout
  title={product?.name || 'Peça no trobada'}
  description={product?.description}
  noindex={!product}
>
  {structuredData && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
  )}
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="Ruta de navegació">
      <a href="/">Inici</a>
      <span aria-hidden="true">/</span>
      <a href="/products">La col·lecció</a>
      <span aria-hidden="true">/</span>
      <span>{product?.name || 'Peça no trobada'}</span>
    </nav>
    {product ? (
      <ProductView client:load product={product} email={store.email} />
    ) : (
      <div class="empty-state">
        <span aria-hidden="true">✳</span>
        <h1>Aquesta peça no és aquí.</h1>
        <p>
          {catalog.error ||
            'Potser ja ha trobat unes noves mans. Descobreix la resta de la col·lecció.'}
        </p>
        <a class="button" href="/products">
          Torna a la col·lecció ↗
        </a>
      </div>
    )}
    {product && related.length > 0 && (
      <section class="section-space">
        <div class="section-heading">
          <div>
            <p class="eyebrow">UNA MICA MÉS DE COLOR</p>
            <h2>També et poden agradar.</h2>
          </div>
          <a class="text-link" href="/products">
            Totes les peces ↗
          </a>
        </div>
        <div class="product-grid">
          {related.map((piece, index) => (
            <ProductCard product={piece} index={index} client:load />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
