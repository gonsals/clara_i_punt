# Server-only credentials. Put real values in .env.local, never commit them.
AIRTABLE_API_KEY=
AIRTABLE_DB_ID=
AIRTABLE_PRODUCTS_TABLE=Productos
# Local design preview only. Set false to hide fictional sample products.
SHOW_PRODUCT_PLACEHOLDERS=true
# Public canonical origin once the site is deployed.
SITE_URL=https://clara-i-punt.vercel.app
